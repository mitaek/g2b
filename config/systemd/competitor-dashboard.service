[Unit]
Description=Competitor Sales Dashboard (FastAPI)
After=network.target

[Service]
Type=simple
# TODO: 실제 배포 계정/경로로 교체하세요.
User=deploy
WorkingDirectory=/opt/competitor-dashboard
EnvironmentFile=/opt/competitor-dashboard/.env
ExecStart=/opt/competitor-dashboard/.venv/bin/uvicorn src.api_server:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
