# 공공데이터포털에서 발급받은 서비스 키 (Swagger에서 확인 후 교체)
SERVICE_KEY=REPLACE_ME

# 조달청_나라장터종합쇼핑몰품목정보서비스 - 납품요구상세정보조회
BASE_URL=https://apis.data.go.kr/1230000/at/ShoppingMallPrdctInfoService/getDlvrReqDtlInfoList

# 응답 필드 매핑은 코드량이 많아 src/collect_data.py의 FIELD_MAP에서 직접 관리합니다.
# 이 값은 참고용 placeholder이며, 실제로는 collect_data.py를 수정하세요.
FIELD_MAP=see_src/collect_data.py

# 로컬: SQLite, 서버: PostgreSQL로 교체 (예: postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///data/app.db
